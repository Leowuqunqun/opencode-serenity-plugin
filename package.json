{
  "name": "opencode-serenity-plugin",
  "version": "0.0.1",
  "private": true,
  "description": "OpenCode 平台本地插件，承载「宁静号」5 条需求 (RR1-RR7)。v0.0.1 首个可用版本：server entry (RR1-RR7 hooks) + TUI entry (激活 toast)。",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage *.tsbuildinfo"
  },
  "keywords": [
    "opencode",
    "plugin",
    "serenity",
    "msm"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "@opencode-ai/plugin": "1.16.2",
    "@opencode-ai/sdk": "1.16.2",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
